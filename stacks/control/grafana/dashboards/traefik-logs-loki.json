{
  "uid": "traefik-logs-loki",
  "title": "traefik logs (loki)",
  "timezone": "browser",
  "refresh": "10s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "schemaVersion": 39,
  "editable": true,
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Requests by service (from logs)",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "loki",
        "uid": "Loki"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 5
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (ServiceName) (count_over_time({job=\"traefik\", service=\"traefik-access\"}[$__auto]))",
          "legendFormat": "{{ServiceName}}",
          "queryType": "range",
          "datasource": {
            "type": "loki",
            "uid": "Loki"
          }
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "5xx by service",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "loki",
        "uid": "Loki"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 5
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (ServiceName) (count_over_time({job=\"traefik\", service=\"traefik-access\"} | status=~\"5..\" [$__auto]))",
          "legendFormat": "{{ServiceName}}",
          "queryType": "range",
          "datasource": {
            "type": "loki",
            "uid": "Loki"
          }
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "4xx by service",
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "loki",
        "uid": "Loki"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 5
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (ServiceName) (count_over_time({job=\"traefik\", service=\"traefik-access\"} | status=~\"4..\" [$__auto]))",
          "legendFormat": "{{ServiceName}}",
          "queryType": "range",
          "datasource": {
            "type": "loki",
            "uid": "Loki"
          }
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "p99 duration by service",
      "gridPos": {
        "x": 12,
        "y": 9,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "loki",
        "uid": "Loki"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 5
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "quantile_over_time(0.99, {job=\"traefik\", service=\"traefik-access\"} | json | unwrap Duration [$__auto]) by (ServiceName) / 1e9",
          "legendFormat": "{{ServiceName}}",
          "queryType": "range",
          "datasource": {
            "type": "loki",
            "uid": "Loki"
          }
        }
      ]
    },
    {
      "id": 5,
      "type": "table",
      "title": "Status codes by service (selected range)",
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "loki",
        "uid": "Loki"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 5
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (ServiceName, status) (count_over_time({job=\"traefik\", service=\"traefik-access\"}[$__range]))",
          "legendFormat": "",
          "queryType": "instant",
          "datasource": {
            "type": "loki",
            "uid": "Loki"
          }
        }
      ],
      "transformations": []
    },
    {
      "id": 6,
      "type": "table",
      "title": "Top paths (selected range)",
      "gridPos": {
        "x": 12,
        "y": 18,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "loki",
        "uid": "Loki"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 5
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(20, sum by (RequestHost, RequestPath) (count_over_time({job=\"traefik\", service=\"traefik-access\"} | json | __error__=\"\" [$__range])))",
          "legendFormat": "",
          "queryType": "instant",
          "datasource": {
            "type": "loki",
            "uid": "Loki"
          }
        }
      ],
      "transformations": []
    },
    {
      "id": 7,
      "type": "logs",
      "title": "Recent 5xx lines",
      "gridPos": {
        "x": 0,
        "y": 27,
        "w": 24,
        "h": 10
      },
      "datasource": {
        "type": "loki",
        "uid": "Loki"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 5
          }
        },
        "overrides": []
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": false,
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{job=\"traefik\", service=\"traefik-access\"} | status=~\"5..\" | json | line_format \"{{.host}} {{.ServiceName}} {{.RequestMethod}} {{.RequestPath}} {{.DownstreamStatus}} {{.Duration}}\"",
          "legendFormat": "",
          "queryType": "range",
          "datasource": {
            "type": "loki",
            "uid": "Loki"
          }
        }
      ]
    }
  ]
}